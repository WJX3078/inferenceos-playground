{
  "name": "inferenceos-playground",
  "private": true,
  "version": "1.0.0",
  "description": "Deterministic, browser-based LLM serving systems simulator: token-budget scheduling, chunked prefill, paged KV cache, prefix caching, cost-aware preemption, speculative decoding, disaggregated prefill/decode with KV transfer, SLO/goodput, and reproducible experiments.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "experiment": "node scripts/experiment.ts",
    "check": "npm test && npm run build && npm run test:e2e",
    "docs:check": "node scripts/docs-check.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.11"
  },
  "license": "MIT"
}
